# Pinned fastlane version for reproducible store-submission builds.
#
# Install via: `cd mobile && bundle install` (one-off, after Ruby is on
# PATH). Run via: `cd mobile && bundle exec fastlane <platform> <lane>`.
# The Makefile wraps these calls into `make ios-submit` / `make
# android-upload` etc.
#
# Fastlane 2.x is the current major; the team backports security fixes
# but the API can drift between versions. Pinning to the minor protects
# against an unexpected breaking change between releases.

source "https://rubygems.org"

gem "fastlane", "~> 2.222"

plugins_path = File.join(File.dirname(__FILE__), 'fastlane', 'Pluginfile')
eval_gemfile(plugins_path) if File.exist?(plugins_path)
