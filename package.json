{
  "name": "sky-score",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-Powered Property Noise Intelligence for London and New York",
  "scripts": {
    "lint": "eslint index.html",
    "lint:fix": "eslint index.html --fix",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"index.html\"",
    "lint:security": "eslint index.html --no-eslintrc -c eslint.config.js",
    "format": "prettier --write index.html",
    "format:check": "prettier --check index.html",
    "test:e2e": "npx playwright test",
    "test:api": "node tests/api.test.mjs",
    "lighthouse": "lighthouse https://d1oe4ftwutjpf.cloudfront.net --output=html --output-path=./reports/lighthouse.html --chrome-flags=\"--headless\"",
    "audit": "npm run lint && npm run lint:html && npm audit",
    "audit:security": "npm audit && eslint index.html && ruff check backend/lambdas/",
    "build:android": "cd mobile && npm run sync && npm run build:assets && cd android && ./gradlew bundleRelease",
    "upload:android": "cd mobile && bundle exec fastlane android deploy_internal",
    "trigger:ios": "git push origin master",
    "submit:ios": "cd mobile && bundle exec fastlane ios submit_for_review",
    "screenshots:ios": "node tests/screenshots.mjs",
    "screenshots:android": "node tests/android-screenshots.mjs",
    "feature-graphic:android": "node tests/android-feature-graphic.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.42.0",
    "eslint": "^9.0.0",
    "eslint-plugin-html": "^8.0.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^15.0.0",
    "html-validate": "^10.11.1",
    "prettier": "^3.2.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
