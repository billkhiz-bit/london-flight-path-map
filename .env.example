# Sky Score local environment template
# Copy to .env and fill in real values. .env is gitignored — never commit.

# AWS profile used for SAM deploys
AWS_PROFILE=flightmap

# Bearer token for the new EPC service (https://get-energy-performance-data.communities.gov.uk)
# Sign in via GOV.UK One Login, copy from "My account" page. NoEcho on the SAM parameter.
EPC_BEARER_TOKEN=your_bearer_token_here

# API key used by scripts/check_score_sanity.py and the parity tests, sourced
# automatically by scripts/preflight.sh. It belongs to the SkyScoreCiTier usage
# plan (10,000/month), created 2026-08-07.
#
# Do NOT reuse the demo key embedded in score-demo/index.html. That key is
# public, which is fine for secrecy and fatal for quota: it put a blocking
# preflight stage on the same 2,000/month allowance as a page anyone can load,
# and when the allowance ran out the gate went red with nothing wrong in the
# tree, blocking every commit until the counter reset on the 1st.
#
# Without this set, `score sanity` fails with an explicit message rather than
# quietly falling back to a shared key.
SKY_SCORE_API_KEY=your_ci_api_key_here

# Free-tier key for tests/demo-key-scope.mjs (added 2026-08-31, audit F15).
#
# Without it, the two assertions that file calls LOAD-BEARING - "if this deny
# stops working the free tier is 1,000,000 scores a month, twice Professional's
# entire published ceiling, for free" - do not run. They had never run: the
# variable was named in the test and existed nowhere else in the repo, so the
# stage printed SKIP and then OK, and the SKIP scrolled past. The summary now
# names it as unproven instead.
#
# Deliberately NOT the CI key above: that one is on SkyScoreCiTier, and a key
# from the wrong plan would satisfy a free-tier assertion while proving nothing
# - conflating key and plan is exactly the shared-quota incident this file
# already warns about.
#
# Mint one with a throwaway address:
#   curl -X POST "$API/v1/signup" -H 'Content-Type: application/json' #        -d '{"email":"you+freetier@example.com","source":"consumer"}'
# It costs nothing to hold: the probes are refused at the edge, and API Gateway
# does not meter a throttled request.
SKY_SCORE_FREE_TIER_KEY=your_free_tier_key_here

# OpenSky env vars removed in May 2026 along with the live_flights Lambda.
# OpenSky's terms (https://opensky-network.org/about/terms-of-use) require
# a written agreement for any operational use, so the live-aircraft feature
# was removed from both the consumer site and the prototype until a licence
# is in place. To restore: revert commit a214ba0 (Lambda) + the live-flights
# removal commit (frontend), then add OPENSKY_CLIENT_ID + OPENSKY_CLIENT_SECRET
# back here.

# ----------------------------------------------------------------------------
# fastlane secrets (mobile/ — store submission only, not loaded by SAM)
# ----------------------------------------------------------------------------
# Android — Play Console service account JSON, created at
# Play Console → Setup → API access → Service accounts. Save the file outside
# the repo (e.g. ~/.secrets/skyscore-play-console.json) and point this at it.
PLAY_CONSOLE_JSON_KEY=/absolute/path/to/skyscore-play-console.json

# Optional override for the AAB path. Leave unset to use the default
# mobile/android/app/build/outputs/bundle/release/app-release.aab
# ANDROID_AAB_PATH=

# iOS — App Store Connect API key, created at
# appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API.
# Download the .p8 once (Apple won't let you download it again) and store
# outside the repo, e.g. ~/.secrets/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_FILE_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# fastlane auto-rewrites mobile/fastlane/README.md after every run unless this is set.
# Always keep this on — we maintain README.md by hand for setup/verification notes.
FASTLANE_SKIP_DOCS=1

# Companies House public data API — free key for scripts/check_name.py, which
# screens candidate brand names for company-name collisions by SIC code.
# Register at https://developer.company-information.service.gov.uk/
# Read-only public data; no write access, nothing sensitive. Rate limit is
# ~600 requests per 5 minutes.
COMPANIES_HOUSE_API_KEY=
