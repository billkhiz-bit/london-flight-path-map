backend/samconfig.toml
backend/.aws-sam/
.claude/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# Cert material — never commit even by accident. The Codemagic CERT_PRIVATE_KEY
# env var is the persistence path; local .pem files are transient.
*.pem
*.p12
*.b64
*.jks
*.keystore
mobile/android/keystore.properties
.DS_Store
Thumbs.db
desktop.ini

# Local layout-verification screenshots from tests/ipad-verify.mjs.
# Regenerated on demand; not part of any shipped artefact.
mobile/.preview/
*.log
.vscode/
.idea/
node_modules/
reports/
playwright-report/
test-results/

# Legacy prototype files — root-anchored so the archived copies in
# archive/prototype-2026-03/ stay tracked (unanchored patterns match at
# any depth and were silently excluding them).
/london_flight_paths.html
/london_flight_paths.py
test-docs/

# Layout-verification screenshots regenerated by tests/*.mjs harnesses
# (live-mobile-verify, native-sim-render, screenshots) — artefacts, not source.
tests/*.png

# Bulk data inputs for one-off loaders (DEFRA GeoTIFF ~500 MB, NSPL CSV ~250 MB).
# See scripts/load_defra_raster.py for download URLs and runbook.
# Use data/* (not data/) so the un-ignore below for borough-extra.json
# actually wins; `data/` ignores the dir itself, defeating the negation.
data/*
# F-Perf-10: small borough-metadata JSON IS checked in (extracted from
# index.html for lazy-loading). Everything else under data/ stays ignored.
!data/borough-extra.json
# visual fix-DEFRA-5: aircraft noise PNG cached on our origin, served from
# CloudFront edge. Refreshes via scripts/refresh_aircraft_noise.sh whenever
# DEFRA publishes a new Round of strategic noise mapping.
!data/aircraft-noise-london-lden.png
# London borough boundaries (123 KB), generated by
# scripts/build_london_boroughs.py. Checked in because init() awaits it before
# first paint — fetching it from raw.githubusercontent.com meant a 19.2 MB
# third-party download gated the app rendering at all. Regenerate when the ONS
# LAD vintage rolls, and bump sw.js VERSION in the same commit.
!data/london-boroughs.json
.defra_load_checkpoint
# Loader resume state (plus its .tmp sibling from the atomic write). Committing
# one is actively dangerous: this repo syncs only via git, so another device
# would silently resume a load it never ran and then stamp __META__ for it.
.nspl_load_checkpoint*
